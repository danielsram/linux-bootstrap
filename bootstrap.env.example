# Copy to bootstrap.env and edit. Sourced by bootstrap.sh, overrides the
# defaults in the script's CONFIGURATION block. Everything here is optional.
#
#   cp bootstrap.env.example bootstrap.env

# --- Git identity (leave the placeholders to skip the git-config step) --------
GIT_NAME="YOUR_NAME"
GIT_EMAIL="YOUR_EMAIL"

# --- Versions ----------------------------------------------------------------
# SDKMAN identifiers are always full versions (e.g. 25.0.1-open) — there is no
# bare-major form. Give the major version and vendor and bootstrap.sh resolves
# them against `sdk list java` at runtime; or set JAVA_VERSION to pin one exact
# identifier and skip the lookup.
JAVA_MAJOR="25"
JAVA_VENDOR="open"
JAVA_VERSION=""                # e.g. 25.0.1-open — empty = resolve from JAVA_MAJOR/JAVA_VENDOR

NODE_VERSION="lts/*"
NVM_VERSION="v0.40.3"

# Leave empty to resolve automatically at runtime.
KUBERNETES_MINOR=""            # e.g. 1.34 — empty = dl.k8s.io/release/stable.txt
YQ_VERSION=""                  # e.g. v4.44.3 — empty = latest GitHub release
MONGODB_COMPASS_VERSION=""     # e.g. 1.46.0 — empty = latest GitHub release
PROTONVPN_RELEASE_DEB=""       # full .deb URL — empty = newest in the Proton repo index

# --- Developer tooling -------------------------------------------------------
INSTALL_BASE=true
INSTALL_CLI_TOOLS=true         # jq, htop, net-tools
INSTALL_PYTHON=true
INSTALL_YQ=true                # mikefarah/yq binary (not the apt `yq`)
INSTALL_GIT_CONFIG=true
INSTALL_JAVA=true
INSTALL_NODE=true
INSTALL_DOCKER=true
INSTALL_KUBECTL=true
INSTALL_HELM=true
INSTALL_TERRAFORM=true
INSTALL_AWS_CLI=true
INSTALL_GCLOUD=true
INSTALL_CLAUDE_CODE=true

# --- Desktop applications ----------------------------------------------------
# No official ARM64 Linux build: CHROME, SLACK, SPOTIFY, ZOOM, INSOMNIA,
# PROTONVPN. They are attempted anyway and reported as FAILED in the summary —
# set them to false on an ARM64 machine to keep the output clean.
INSTALL_BRAVE=true
INSTALL_CHROME=true
INSTALL_SUBLIME=true
INSTALL_INTELLIJ=true
INSTALL_LENS=true
INSTALL_MONGODB_COMPASS=true
INSTALL_SLACK=true             # via snap
INSTALL_SPOTIFY=true           # via snap
INSTALL_VLC=true
INSTALL_ZOOM=true
INSTALL_INSOMNIA=true
INSTALL_DELUGE=true
INSTALL_PROTONVPN=true
INSTALL_NORDVPN=false

# --- Shell configuration (k/g/t aliases, completion, nvm/SDKMAN init) --------
INSTALL_SHELL_CONFIG=true

# --- Log ---------------------------------------------------------------------
# Empty = $HOME/bootstrap-<timestamp>.log
LOG_FILE=""
